# Supabase Connection — fill in your Supabase project values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API — points to the same server via Nginx /api/ proxy
VITE_API_BASE_URL=http://hackbridge.mitt.edu.in/api

# Institution tenant slug (do not change)
VITE_DEFAULT_TENANT_SLUG=mitt
