# ============================================================================
# HackBridge Environment Configuration (.env.example)
# Copy this file to .env and supply actual deployment values.
# NEVER commit real production secrets to version control.
# ============================================================================

# ── Frontend Configuration ──────────────────────────────────────────────────
# 1. Supabase Connection (Required if using Supabase client directly)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Portable Backend REST API (Optional: point to decoupled /backend service)
VITE_API_BASE_URL=http://localhost:4000

# 3. Default Institution Tenant Slug (Pilot: 'mitt')
VITE_DEFAULT_TENANT_SLUG=mitt

# ── Portable Backend / Database Configuration (used by /backend) ────────────
PORT=4000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/hackbridge
JWT_SECRET=your-secure-random-32-character-secret-key-here
CORS_ORIGIN=*
