# ============================================================================
# HackBridge Backend Environment Configuration
# Domain: hackbridge.mitt.edu.in
# ============================================================================

PORT=4000
NODE_ENV=production

# PostgreSQL — update password to whatever you set in Phase 4
DATABASE_URL=postgresql://hackbridge_user:CHANGE_THIS_PASSWORD@localhost:5432/hackbridge

# Generate your own: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_32_CHARS_MIN

# Allow requests from your domain
CORS_ORIGIN=http://hackbridge.mitt.edu.in

DEFAULT_TENANT_SLUG=mitt
UPLOAD_DIR=./uploads
